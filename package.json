{
	"name": "glipper",
	"version": "1.3.0",
	"description": "An easy utility for game clip cutting.",
	"main": "./out/main/index.js",
	"author": "Jakub Tabacek",
	"license": "GPL-3.0",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint --cache . --fix",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"dev:watch": "electron-vite dev --watch",
		"build": "pnpm run typecheck && node copy-prisma-files.js && electron-vite build",
		"postinstall": "install-electron && electron-builder install-app-deps",
		"build:unpack": "pnpm run build && electron-builder --dir",
		"build:win": "pnpm run build && electron-builder --win --publish never",
		"build:mac": "pnpm run build && electron-builder --mac --publish never",
		"build:linux": "pnpm run build && electron-builder --linux --publish never",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:generate": "prisma generate",
		"prisma:studio": "prisma studio"
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@primeuix/themes": "^2.0.3",
		"@prisma/client": "6.19.3",
		"@prisma/engines": "^6.19.3",
		"@vue/devtools-api": "^8.2.1",
		"date-fns": "^4.4.0",
		"electron-clipboard-ex": "^1.3.3",
		"electron-log": "^5.4.4",
		"electron-updater": "^6.8.9",
		"ffmpeg-static": "^5.3.0",
		"ffprobe-static": "^3.1.0",
		"fluent-ffmpeg": "^2.1.3",
		"pinia": "^4.0.3",
		"primeicons": "^7.0.0",
		"primevue": "^4.5.4",
		"tailwindcss-primeui": "^0.6.1"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "^3.0.0",
		"@electron-toolkit/eslint-config-ts": "^3.1.0",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/fluent-ffmpeg": "^2.1.28",
		"@types/node": "^24.13.4",
		"@vitejs/plugin-vue": "^6.0.9",
		"electron": "^44.3.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-plugin-vue": "^10.11.0",
		"fs-extra": "^11.4.0",
		"prettier": "^3.9.6",
		"prisma": "^6.19.3",
		"replace-in-file": "^9.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vue": "^3.5.42",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"electron",
			"electron-clipboard-ex",
			"esbuild",
			"ffmpeg-static",
			"prisma"
		],
		"overrides": {
			"@xmldom/xmldom": "^0.8.15",
			"brace-expansion@1": "^1.1.18",
			"brace-expansion@2": "^2.1.4",
			"browserslist": "^4.28.7",
			"cross-spawn@7": "^7.0.5",
			"deepmerge-ts": "^8.0.0",
			"flatted": "^3.4.2",
			"js-yaml@4": "^4.3.2",
			"lodash": "^4.18.0",
			"minimatch@3": "^3.1.4",
			"minimatch@5": "^5.1.8",
			"minimatch@9": "^9.0.7",
			"tmp": "^0.2.6",
			"yaml@2": "^2.8.3"
		}
	},
	"packageManager": "pnpm@10.34.5"
}
